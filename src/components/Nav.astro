---
import { site } from '../config';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="nav">
  <div class="nav__inner">
    <a class="brand" href="/" aria-label={`${site.name} 首页`}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">{site.name}</span>
      <span class="brand__sub" aria-hidden="true">/ portfolio</span>
    </a>

    <nav class="nav__links" aria-label="主导航">
      {
        site.nav.map((item, i) => (
          <a class="nav__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <span class="nav__meta" aria-hidden="true">SYSTEM / 2026</span>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-label="打开菜单">
      <span></span>
    </button>
  </div>

  <div class="nav__drawer" id="nav-drawer" data-open="false">
    <nav aria-label="移动端导航">
      {
        site.nav.map((item, i) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            <span class="mono">0{i + 1}</span>
            {item.label}
          </a>
        ))
      }
      <a href={`mailto:${site.email}`}>
        <span class="mono">05</span>
        联系
      </a>
    </nav>
  </div>
</header>
