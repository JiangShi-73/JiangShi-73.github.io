---
import { site } from '../config';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="nav">
  <div class="nav__inner wrap">
    <a class="brand" href="/" aria-label={`${site.name} 首页`}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path d="M12 2.5v19M3.4 7.25l17.2 9.5M20.6 7.25L3.4 16.75" />
        </svg>
      </span>
      <span>{site.name}</span>
    </a>

    <nav class="nav__links" aria-label="主导航">
      {
        site.nav.map((item) => (
          <a class="nav__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="nav__cta" href={`mailto:${site.email}`}>
      聊聊
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h13M13 6l6 6-6 6" />
      </svg>
    </a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-label="打开菜单">
      <span></span>
    </button>
  </div>

  <div class="nav__drawer" id="nav-drawer" data-open="false">
    <nav aria-label="移动端导航">
      {
        site.nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={`mailto:${site.email}`}>联系我</a>
    </nav>
  </div>
</header>
