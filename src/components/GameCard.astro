---
import type { Game } from '../data/games';

interface Props {
  game: Game;
  index?: number;
  delay?: number;
}

const { game, index, delay = 0 } = Astro.props;
---

<article class="game-card reveal" style={`--d: ${delay}ms`}>
  <div class="game-card__media">
    {index !== undefined && <span class="game-card__no" aria-hidden="true">NO. {String(index + 1).padStart(2, '0')}</span>}
    <img src={game.cover} alt={`${game.title} 封面`} loading="lazy" decoding="async" />
  </div>
  <div class="game-card__body">
    <span class="game-card__sub">{game.subtitle}</span>
    <h3>{game.title}</h3>
    <div class="game-card__meta">
      <span>{game.year}</span>
      <i style="width:3px;height:3px;background:currentColor" aria-hidden="true"></i>
      <span>{game.platform}</span>
    </div>
    <p>{game.note}</p>
  </div>
</article>
