---
import { site } from '../config';

interface Props {
  noCta?: boolean;
}

const { noCta = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    {
      !noCta && (
        <div class="footer__cta reveal">
          <h2>
            有喜欢的？<br />
            <span class="grad nowrap">推荐给我</span>。
          </h2>
          <a class="footer__mail" href={`mailto:${site.email}`}>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M3 6h18v12H3z" />
              <path d="M3 7l9 6 9-6" />
            </svg>
            {site.email}
          </a>
        </div>
      )
    }

    <div class="footer__bottom">
      <p>© {year} {site.name} — 用 Astro 构建</p>
      <div class="footer__socials">
        {
          site.socials.map((item) => (
            <a href={item.href} target="_blank" rel="noreferrer noopener">
              {item.label}
            </a>
          ))
        }
      </div>
      <a href="#main" class="footer__top">回到顶部 ↗</a>
    </div>
  </div>
</footer>
