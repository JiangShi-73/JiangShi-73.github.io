---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
  noFooterCta?: boolean;
  /** 'dark' 是档案舱（学业与开发）的深色主题，其余页面默认米白 */
  theme?: 'paper' | 'dark';
}

const { title, description = site.description, noFooterCta = false, theme = 'paper' } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} · ${site.eyebrow}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');
---

<!doctype html>
<html lang="zh-CN" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content={theme === 'dark' ? '#0c1016' : '#ece7dc'} />
    <meta name="color-scheme" content={theme === 'dark' ? 'dark' : 'light'} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // 兜底：若交互脚本因网络原因没加载，2.5s 后直接显示内容，避免空白页
      window.setTimeout(function () {
        document.querySelectorAll('.reveal:not(.is-in)').forEach(function (el) {
          el.classList.add('is-in');
        });
      }, 2500);
    </script>
  </head>
  <body data-theme={theme}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="ambient" aria-hidden="true"></div>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer noCta={noFooterCta} />
    <div class="scan" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <script>
      // 顶部导航滚动状态
      const nav = document.querySelector('.nav');
      const syncNav = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
      syncNav();
      window.addEventListener('scroll', syncNav, { passive: true });

      // 移动端菜单
      const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
      const drawer = document.querySelector<HTMLElement>('.nav__drawer');

      const setMenu = (open: boolean) => {
        if (!toggle || !drawer) return;
        drawer.dataset.open = String(open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
        document.body.style.overflow = open ? 'hidden' : '';
      };

      if (toggle && drawer) {
        toggle.addEventListener('click', () => setMenu(drawer.dataset.open !== 'true'));
        drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
        window.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenu(false);
        });
      }

      // 滚动入场
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      if (reveals.length) {
        if (!('IntersectionObserver' in window)) {
          reveals.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-in');
                  io.unobserve(entry.target);
                }
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          reveals.forEach((el) => io.observe(el));
        }
      }

      // 歌单行内播放：展开网易云外链播放器，同一时间只保留一个
      const closeDecks = () => {
        document.querySelectorAll<HTMLElement>('.deck').forEach((deck) => {
          deck.hidden = true;
          const frame = deck.querySelector('.deck__frame');
          if (frame) frame.innerHTML = '';
        });
        document.querySelectorAll<HTMLButtonElement>('.track__play.is-on').forEach((btn) => {
          btn.classList.remove('is-on');
          btn.setAttribute('aria-expanded', 'false');
        });
      };

      document.addEventListener('click', (event) => {
        const target = event.target as Element;
        if (target.closest('.deck__close')) {
          closeDecks();
          return;
        }
        const btn = target.closest<HTMLButtonElement>('.track__play[data-id]');
        if (!btn) return;
        const deck = btn.closest('.track-unit')?.querySelector<HTMLElement>('.deck');
        if (!deck) return;
        const wasOpen = !deck.hidden;
        closeDecks();
        if (wasOpen) return;
        deck.hidden = false;
        btn.classList.add('is-on');
        btn.setAttribute('aria-expanded', 'true');
        const frame = deck.querySelector('.deck__frame');
        if (frame) {
          const iframe = document.createElement('iframe');
          iframe.src = `https://music.163.com/outchain/player?type=2&id=${btn.dataset.id}&auto=1&height=66`;
          iframe.height = '66';
          iframe.title = btn.getAttribute('aria-label') ?? '播放器';
          iframe.setAttribute('allow', 'autoplay; encrypted-media');
          frame.appendChild(iframe);
        }
      });
    </script>
  </body>
</html>
