---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../config';
import { projects } from '../data/projects';

const featured = projects.filter((project) => project.featured).slice(0, 3);

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const posts = allPosts.slice(0, 4);

const formatDate = (date: Date) =>
  date
    .toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
    .replaceAll('/', '.');

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout>
  <!-- 首屏 -->
  <section class="hero">
    <div class="hero__reticle" aria-hidden="true">
      <img src="/images/reticle.svg" alt="" width="800" height="800" fetchpriority="high" />
    </div>

    <div class="wrap hero__inner">
      <div class="hero__top">
        <span>SITE 001 / PORTFOLIO — 2026</span>
        <span class="hero__coords">30.2741° N / 120.1551° E · HANGZHOU</span>
      </div>

      <div class="hero__main">
        <p class="eyebrow reveal">{site.eyebrow}</p>

        <h1 class="hero__title reveal" style="--d: 80ms">
          <span>把想法，</span>
          <span>做成<span class="grad">看得见</span></span>
          <span>的东西。</span>
        </h1>

        <p class="hero__lede reveal" style="--d: 160ms">
          我是 {site.author}，做界面、写代码，也记录一些关于设计与工程的思考。
          这里放着做过的项目，和一些正在想的事。
        </p>

        <div class="hero__actions reveal" style="--d: 240ms">
          <a class="btn btn--primary" href="/projects">
            看看项目
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6" />
            </svg>
          </a>
          <a class="btn btn--ghost" href="/blog">读读文章</a>
        </div>
      </div>

      <div class="hero__stats reveal" style="--d: 320ms">
        <div class="stat">
          <div class="stat__num">{pad(projects.length)}</div>
          <div class="stat__label">Projects</div>
        </div>
        <div class="stat">
          <div class="stat__num">{pad(allPosts.length)}</div>
          <div class="stat__label">Writing</div>
        </div>
        <div class="stat">
          <div class="stat__num">{pad(6)}</div>
          <div class="stat__label">Years</div>
        </div>
        <div class="scroll-hint" style="margin-left: auto">
          <span></span>
          Scroll
        </div>
      </div>
    </div>
  </section>

  <!-- 跑马灯 -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...site.marquee, ...site.marquee].map((word) => <span class="marquee__item">{word}</span>)}
    </div>
  </div>

  <!-- 一句话 -->
  <section class="section--tight">
    <div class="wrap">
      <p class="mono reveal" style="margin-bottom: 1rem">// STATEMENT</p>
      <blockquote class="statement reveal" style="margin-left: 0; margin-right: 0">
        好的界面不解释自己，它只是刚好
        <span>顺手</span>。
      </blockquote>
    </div>
  </section>

  <!-- 精选项目 -->
  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Selected Work</p>
          <h2>最近做的一些事</h2>
        </div>
        <a class="section-head__link" href="/projects">
          全部项目
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M9 7h8v8" />
          </svg>
        </a>
      </div>

      <div class="projects-grid">
        {featured.map((project, index) => <ProjectCard project={project} index={index} delay={index * 90} />)}
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Writing</p>
          <h2>最近写下的</h2>
        </div>
        <a class="section-head__link" href="/blog">
          全部文章
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <div class="posts">
        {
          posts.map((post, index) => (
            <a class="post-row reveal" href={`/blog/${post.id}`} style={`--d: ${index * 60}ms`}>
              <time class="post-row__date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <div>
                <h3 class="post-row__title">{post.data.title}</h3>
                <p class="post-row__desc">{post.data.description}</p>
              </div>
              <div class="post-row__tags">
                {post.data.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
