---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoTile from '../components/PhotoTile.astro';
import TrackRow from '../components/TrackRow.astro';
import GameCard from '../components/GameCard.astro';
import FilmCard from '../components/FilmCard.astro';
import Arrow from '../components/Arrow.astro';
import { getCollection } from 'astro:content';
import { site } from '../config';
import { photos } from '../data/photos';
import { tracks } from '../data/music';
import { games } from '../data/games';
import { films } from '../data/films';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const posts = allPosts.slice(0, 3);

const formatDate = (date: Date) =>
  date
    .toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
    .replaceAll('/', '.');

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout>
  <!-- 首屏 -->
  <section class="hero">
    <div class="hero__panel" aria-hidden="true">
      <img class="hero__reticle" src="/images/reticle.svg" alt="" width="800" height="800" fetchpriority="high" />
    </div>

    <div class="wrap hero__inner">
      <div class="hero__top">
        <span>SITE 001 / COLLECTION — 2026</span>
        <span class="hero__top-ticks" aria-hidden="true"></span>
        <span class="hero__coords">30.2741° N / 120.1551° E · HANGZHOU</span>
      </div>

      <div class="hero__main">
        <p class="eyebrow reveal">{site.eyebrow}</p>

        <h1 class="hero__title reveal" style="--d: 80ms">
          <span>喜欢的</span>
          <span>游戏、<span class="grad">音乐</span></span>
          <span>和剧。</span>
        </h1>

        <p class="hero__lede reveal" style="--d: 160ms">
          我是 {site.author}。这里不放作品集，只收我喜欢的——
          玩进去的、单曲循环的、追完还会想起的，还有路上拍到的。看到什么就放什么。
        </p>

        <div class="hero__actions reveal" style="--d: 240ms">
          <a class="btn btn--primary" href="/games">
            看看游戏
            <Arrow />
          </a>
          <a class="btn btn--ghost" href="/music">听听歌</a>
        </div>
      </div>

      <div class="hero__stats reveal" style="--d: 320ms">
        <div class="stat">
          <div class="stat__num">{pad(games.length)}</div>
          <div class="stat__label">Games</div>
        </div>
        <div class="stat">
          <div class="stat__num">{pad(tracks.length)}</div>
          <div class="stat__label">Tracks</div>
        </div>
        <div class="stat">
          <div class="stat__num">{pad(films.length)}</div>
          <div class="stat__label">Films</div>
        </div>
        <div class="stat">
          <div class="stat__num">{pad(photos.length)}</div>
          <div class="stat__label">Photos</div>
        </div>
        <div class="scroll-hint">
          <span></span>
          Scroll
        </div>
      </div>
    </div>
  </section>

  <!-- 跑马灯 -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...site.marquee, ...site.marquee].map((word) => <span class="marquee__item">{word}</span>)}
    </div>
  </div>

  <!-- 游戏 -->
  <section class="section" id="games">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Games</p>
          <h2>玩进去过的</h2>
        </div>
        <a class="section-head__link" href="/games">
          全部 {pad(games.length)} 个
          <Arrow diag />
        </a>
      </div>

      <div class="games-grid">
        {games.map((game, index) => <GameCard game={game} index={index} delay={index * 70} />)}
      </div>
    </div>
  </section>

  <!-- 音乐 -->
  <section class="section section--tight" id="music">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Music</p>
          <h2>一直在听的</h2>
        </div>
        <a class="section-head__link" href="/music">
          全部 {pad(tracks.length)} 首
          <Arrow diag />
        </a>
      </div>

      <div class="tracks">
        {tracks.slice(0, 5).map((track, index) => <TrackRow track={track} index={index} delay={index * 50} />)}
      </div>
    </div>
  </section>

  <!-- 剧 -->
  <section class="section section--tight" id="films">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Films</p>
          <h2>看完还会想起的</h2>
        </div>
        <a class="section-head__link" href="/films">
          全部 {pad(films.length)} 部
          <Arrow diag />
        </a>
      </div>

      <div class="films-grid">
        {films.map((film, index) => <FilmCard film={film} index={index} delay={index * 60} />)}
      </div>
    </div>
  </section>

  <!-- 照片 -->
  <section class="section section--tight" id="photos">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Photos</p>
          <h2>拍到的一些</h2>
        </div>
        <a class="section-head__link" href="/photos">
          全部 {pad(photos.length)} 张
          <Arrow diag />
        </a>
      </div>

      <div class="gallery">
        {photos.slice(0, 4).map((photo, index) => <PhotoTile photo={photo} index={index} delay={index * 60} />)}
      </div>
    </div>
  </section>

  <!-- 文章 -->
  <section class="section section--tight panel-paper">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Writing</p>
          <h2>写下来的</h2>
        </div>
        <a class="section-head__link" href="/blog">
          全部文章
          <Arrow diag />
        </a>
      </div>

      <div class="posts">
        {
          posts.map((post, index) => (
            <a class="post-row reveal" href={`/blog/${post.id}`} style={`--d: ${index * 60}ms`}>
              <time class="post-row__date" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <div>
                <h3 class="post-row__title">{post.data.title}</h3>
                <p class="post-row__desc">{post.data.description}</p>
              </div>
              <div class="post-row__tags">
                {post.data.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 档案舱入口 -->
  <section class="section section--tight" id="archive">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Archive</p>
          <h2>学业与开发</h2>
        </div>
        <a class="section-head__link" href="/work">
          SECTION B
          <Arrow diag />
        </a>
      </div>

      <a class="cta reveal" href="/work">
        <span class="btn btn--cta">
          进入档案舱
          <Arrow />
        </span>
      </a>
    </div>
  </section>
</BaseLayout>