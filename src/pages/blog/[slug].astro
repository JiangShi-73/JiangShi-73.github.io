---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const dateText = post.data.date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const charCount = post.body?.replace(/\s/g, '').length ?? 0;
const minutes = Math.max(1, Math.round(charCount / 400));
---

<BaseLayout title={post.data.title} description={post.data.description} noFooterCta>
  <article class="article">
    <div class="wrap">
      <div class="article__inner">
        <a class="back-link" href="/blog">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H6M11 6l-6 6 6 6" />
          </svg>
          所有文章
        </a>

        <header class="article__head">
          <p class="eyebrow" style="margin-top: 2rem">{post.data.tags[0] ?? 'Note'}</p>
          <h1 class="article__title">{post.data.title}</h1>
          <p class="article__lede">{post.data.description}</p>

          <div class="article__meta">
            <time datetime={post.data.date.toISOString()}>{dateText}</time>
            <i class="dot" aria-hidden="true"></i>
            <span>{minutes} 分钟阅读</span>
            <i class="dot" aria-hidden="true"></i>
            <span>{post.data.tags.join(' / ')}</span>
          </div>
        </header>

        <div class="article__body">
          <div class="prose">
            <Content />
          </div>
        </div>

        <nav class="article__foot" aria-label="文章翻页">
          {
            prev ? (
              <a class="back-link" href={`/blog/${prev.id}`}>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M19 12H6M11 6l-6 6 6 6" />
                </svg>
                上一篇：{prev.data.title}
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a class="back-link" href={`/blog/${next.id}`}>
                下一篇：{next.data.title}
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h13M13 6l6 6-6 6" />
                </svg>
              </a>
            )
          }
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>
