---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面走丢了" noFooterCta>
  <section style="min-height: 76vh; display: grid; place-items: center; text-align: center; padding-top: var(--nav-h)">
    <div class="wrap">
      <p class="mono" style="justify-content: center">ERROR / 404 — NOT FOUND</p>
      <h1 style="margin-top: 1.2rem">这一页<span class="grad">不存在</span>。</h1>
      <p class="hero__lede" style="margin-inline: auto; margin-top: 1.2rem">
        链接可能改过，或者只是敲错了一个字符。
      </p>
      <div class="hero__actions" style="justify-content: center; margin-top: 2rem">
        <a class="btn btn--primary" href="/">回到首页</a>
        <a class="btn btn--ghost" href="/blog">看看文章</a>
      </div>
    </div>
  </section>
</BaseLayout>
