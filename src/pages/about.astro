---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';

const skills = ['界面设计', '设计系统', 'TypeScript', 'React', 'Astro', '数据可视化', '动效', '无障碍', '写作'];
---

<BaseLayout title="关于" description="关于我：做界面、写代码、偶尔写字。" theme="paper">
  <div class="page-paper">
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow reveal">About</p>
      <h1 class="reveal" style="--d: 60ms">你好，我是 <span class="grad">{site.author}</span>。</h1>
    </div>
  </header>

  <section class="section--tight">
    <div class="wrap">
      <div class="about-grid">
        <div class="about-portrait reveal">
          <img src="/images/portrait.svg" alt={`${site.author} 的标志插画`} width="800" height="1000" />
        </div>

        <div class="about-body reveal" style="--d: 120ms">
          <p>
            我是学生，也写代码。这个站不是作品集，更像一个收纳盒——
            游戏、音乐、剧、照片，顺手写点东西。学业和开发成果单独收在档案舱里。
          </p>
          <p>
            我相信界面应该在不需要解释的情况下就顺手——这意味着大量看起来「没什么设计」的决定：
            对齐、留白、层次、动效的分寸。这些细节加起来，才是用户感受到的那一点点顺滑。
          </p>
          <p>
            没什么更新计划，看到喜欢的就丢进来。写下来的那些字，大部分是为了自己想清楚；
            如果恰好对你有用，那就更好了。
          </p>

          <div class="skill-list">
            {skills.map((skill) => <span class="tag">{skill}</span>)}
          </div>
        </div>
      </div>

      <div class="about-timeline">
        <p class="eyebrow">Archive</p>
        <div class="about-archive">
          <a class="btn btn--primary" href="/work">
            进入档案舱
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      </div>

      <div class="section-head reveal" style="margin-top: clamp(3rem, 7vw, 6rem); margin-bottom: 0">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>想聊聊？</h2>
        </div>
        <a class="btn btn--primary" href={`mailto:${site.email}`}>
          {site.email}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
